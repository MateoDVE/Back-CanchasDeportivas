# Copiar estas variables al .env del backend. Nunca incluir secretos en el frontend.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=1h
FRONTEND_URL=http://localhost:4200
# API de Resend con permiso de envío y un remitente de dominio verificado.
RESEND_API_KEY=
MAIL_FROM=Reservas <reservas@tu-dominio.com>
